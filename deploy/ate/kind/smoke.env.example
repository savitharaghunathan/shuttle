# Copy to smoke.env (gitignored) or export these before `make ate-kind-smoke`.
# HTTPS remote the smoke actor can clone/push from inside the cluster.

SMOKE_REPO_URL=https://github.com/OWNER/REPO.git
SMOKE_BRANCH=shuttle/ate-kind-smoke
SMOKE_ACTOR=shuttle-smoke-1

# Required if SMOKE_REPO_URL is private (fine-grained PAT with contents:read/write).
# SMOKE_GIT_TOKEN=ghp_...
# GITHUB_TOKEN=...   # also accepted

# Optional: local checkout used only for docs / shuttle serve local testing
# SHUTTLE_TEST_APP=/path/to/your/checkout
